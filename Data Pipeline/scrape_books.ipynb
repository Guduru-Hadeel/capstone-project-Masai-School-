# MODULE 1 - DATA PIPELINE (/data_pipeline)
import requests, sqlite3
from bs4 import BeautifulSoup
import pandas as pd

# Scrape first 3 pages of Books to Scrape
books = []
for page in range(1,4):
    url = f"http://books.toscrape.com/catalogue/page-{page}.html"
    resp = requests.get(url)
    soup = BeautifulSoup(resp.text, "html.parser")
    for item in soup.select(".product_pod"):
        title = item.h3.a["title"]
        price_text = item.select_one(".price_color").text.strip()
        price = float(price_text.replace('Â£', ''))
        rating = ["One","Two","Three","Four","Five"].index(item.p["class"][1]) + 1
        availability = item.select_one(".availability").text.strip()
        category = "Books"
        books.append((title, price, rating, availability, category))

# DataFrame + cleaning
df = pd.DataFrame(books, columns=["title","price_gbp","rating","availability","category"])
df["price_inr"] = df["price_gbp"] * 105.50

# SQLite schema
conn = sqlite3.connect("books.db")
cur = conn.cursor()
cur.execute("CREATE TABLE IF NOT EXISTS categories(id INTEGER PRIMARY KEY, category_name TEXT UNIQUE)")
cur.execute("""CREATE TABLE IF NOT EXISTS books(
    book_id INTEGER PRIMARY KEY,
    title TEXT,
    price_gbp REAL,
    price_inr REAL,
    rating INTEGER,
    availability TEXT,
    category_id INTEGER REFERENCES categories(id))
    """)

# Insert categories + books
cur.execute("INSERT OR IGNORE INTO categories(category_name) VALUES (?)", ("Books",))
cat_id = cur.execute("SELECT id FROM categories WHERE category_name='Books'").fetchone()[0]
for _,row in df.iterrows():
    cur.execute("INSERT INTO books(title,price_gbp,price_inr,rating,availability,category_id) VALUES (?,?,?,?,?,?)",
                (row.title,row.price_gbp,row.price_inr,row.rating,row.availability,cat_id))
conn.commit()

# Example SQL queries
print(cur.execute("SELECT COUNT(*) FROM books").fetchall())
print(cur.execute("SELECT DISTINCT rating FROM books").fetchall())
print(cur.execute("SELECT title,price_inr FROM books ORDER BY price_inr DESC LIMIT 5").fetchall())

# Pandas SQL read + merge check
df_sql = pd.read_sql("SELECT * FROM books", conn)
df_merge = pd.merge(df, df_sql, left_on="title", right_on="title")
print(df_merge.head())
